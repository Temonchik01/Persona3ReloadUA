  <Speakers>
    <Speaker id="0" rawBytes="4F 74 68 65 72 77 6F 72 6C 64 6C 79 20 56 6F 69 63 65">Потойбічний голос</Speaker>
    <Speaker id="1" rawBytes="57 6F 6D 61 6E 27 73 20 56 6F 69 63 65">Жіночий голос</Speaker>
    <Speaker id="2" rawBytes="4F 6C 64 20 4C 61 64 79">Стара жінка</Speaker>
  </Speakers>
  <Dialog id="0" name="MND_000_0_0" type="Message">
    <Page spk="FFFF"><![CDATA[{f 0 5 254}{f 2 1}Чи варто мені помолитися в храмі Інарі?[n]{f 1 1}]]></Page>
  </Dialog>
  <Dialog id="1" name="SEL_001_0_0" type="Selection">
    <Option><![CDATA[{f 0 5 254}{f 2 1}Я помолюсь.]]></Option>
    <Option><![CDATA[{f 0 5 254}{f 2 1}Що ще я можу тут зробити?]]></Option>
    <Option><![CDATA[{f 0 5 254}{f 2 1}Неважливо.]]></Option>
  </Dialog>
  <Dialog id="2" name="MND_002_0_0" type="Message">
    <Page spk="FFFF"><![CDATA[{f 0 5 254}{f 2 1}Я щось відчуваю...[n]{f 1 1}]]></Page>
  </Dialog>
  <Dialog id="3" name="MSG_003_0_0" type="Message">
    <Page spk="0000"><![CDATA[{f 0 5 254}{f 2 1}Іп-іп![n]{f 1 1}]]></Page>
  </Dialog>
  <Dialog id="4" name="MSG_004_0_0" type="Message">
    <Page spk="0000"><![CDATA[{f 0 5 254}{f 2 1}Що таке? Ви хотіли картку?[n]{f 1 1}]]></Page>
  </Dialog>
  <Dialog id="5" name="MSG_004_5_0" type="Message">
    <Page spk="0000"><![CDATA[{f 0 5 254}{f 2 1}Гаразд, я зроблю її для вас. Це одне з моїх хобі зараз.[n]{f 1 1}]]></Page>
    <Page spk="0000"><![CDATA[{f 0 5 254}{f 2 1}Вибери карту вміння, яка тобі потрібна.[n]{f 1 1}]]></Page>
    <Page spk="0000"><![CDATA[{f 0 5 254}{f 2 1}Коли карт багато, важко обрати одну. Краще частіше ними користуватися, щоб не носити стільки із собою.[n]{f 1 1}]]></Page>
    <Page spk="0000"><![CDATA[{f 0 5 254}{f 2 1}Ну що, почнімо?[n]{f 1 1}]]></Page>
  </Dialog>
  <Dialog id="6" name="MSG_005_0_0" type="Message">
    <Page spk="0000"><![CDATA[{f 0 5 254}{f 2 1}...Гей, у тебе немає нічого.[n]{f 1 1}]]></Page>
    <Page spk="0000"><![CDATA[{f 0 5 254}{f 2 1}Не можу скопіювати карту вміння, якщо в тебе немає жодної.[n]{f 1 1}]]></Page>
  </Dialog>
  <Dialog id="7" name="MSG_006_0_0" type="Message">
    <Page spk="0000"><![CDATA[{f 0 5 254}{f 2 1}Яку карту вміння хочеш скопіювати?[n]{f 1 1}]]></Page>
  </Dialog>
  <Dialog id="8" name="MSG_006_1_0" type="Message">
    <Page spk="0000"><![CDATA[{f 0 5 254}{f 2 1}Ох? Ви передумали?[n]{f 1 1}]]></Page>
  </Dialog>
  <Dialog id="9" name="SEL_007_0_0" type="Selection">
    <Option><![CDATA[{f 0 5 254}{f 2 1}Фізичну]]></Option>
    <Option><![CDATA[{f 0 5 254}{f 2 1}Магічну]]></Option>
    <Option><![CDATA[{f 0 5 254}{f 2 1}Лікування/Підтримка]]></Option>
    <Option><![CDATA[{f 0 5 254}{f 2 1}Пасивну]]></Option>
    <Option><![CDATA[{f 0 5 254}{f 2 1}Вийти]]></Option>
  </Dialog>
  <Dialog id="10" name="SEL_008_0_0" type="Selection">
    <Option><![CDATA[{f 0 5 254}{f 2 1}Так]]></Option>
    <Option><![CDATA[{f 0 5 254}{f 2 1}Ні]]></Option>
  </Dialog>
  <Dialog id="11" name="MSG_009_0_0" type="Message">
    <Page spk="0000"><![CDATA[{f 0 5 254}{f 2 1}Гаразд... Стривай, у тебе вже забагато таких карт.[n]{f 1 1}]]></Page>
    <Page spk="0000"><![CDATA[{f 0 5 254}{f 2 1}Вибери іншу, добре?[n]{f 1 1}]]></Page>
  </Dialog>
  <Dialog id="12" name="MSG_010_0_0" type="Message">
    <Page spk="0000"><![CDATA[{f 0 5 254}{f 2 1}Сьогодні ти вже копіював одну карту.[n]{f 1 1}]]></Page>
    <Page spk="0000"><![CDATA[{f 0 5 254}{f 2 1}Ніхто не любить настирливих... До того ж я втомився.[n]{f 1 1}]]></Page>
  </Dialog>
  <Dialog id="13" name="MSG_011_0_0" type="Message">
    <Page spk="0000"><![CDATA[{f 0 5 254}{f 2 1}Скопіювати карту «{f 4 4 1 37 1 0}»?[n]{f 1 1}]]></Page>
  </Dialog>
  <Dialog id="14" name="MSG_012_0_0" type="Message">
    <Page spk="0000"><![CDATA[{f 0 5 254}{f 2 1}Ну, ось![n]{f 1 1}]]></Page>
    <Page spk="0000"><![CDATA[{f 0 5 254}{f 2 1}......[n]{f 1 1}]]></Page>
    <Page spk="0000"><![CDATA[{f 0 5 254}{f 2 1}Ух, все готово. Давай, бери.[n]{f 1 1}]]></Page>
  </Dialog>
  <Dialog id="15" name="MND_013_0_0" type="Message"/>
  <Dialog id="16" name="MSG_013_1_0" type="Message">
    <Page spk="0000"><![CDATA[{f 0 5 254}{f 2 1}До зустрічі.[n]{f 1 1}]]></Page>
  </Dialog>
  <Dialog id="17" name="MND_014_0_0" type="Message">
    <Page spk="FFFF"><![CDATA[{f 0 5 254}{f 2 1}Відвідувачі залишили суші Інарі як підношення.[n]{f 1 1}]]></Page>
  </Dialog>
  <Dialog id="18" name="MND_015_0_0" type="Message">
    <Page spk="FFFF"><![CDATA[{f 0 5 254}{f 2 1}Завдяки характеристиці «{f 4 30 0 1 1 0}»[n]я спробував придумати, як[n]отримати трохи суші.[n]{f 1 1}]]></Page>
    <Page spk="FFFF"><![CDATA[{f 0 5 254}{f 2 1}......[n]{f 1 1}]]></Page>
    <Page spk="FFFF"><![CDATA[{f 0 5 254}{f 2 1}.........[n]{f 1 1}]]></Page>
  </Dialog>
  <Dialog id="19" name="MSG_016_0_0" type="Message">
    <Page spk="0001"><![CDATA[{f 0 5 254}{f 2 1}Агов, ти![n]{f 1 1}]]></Page>
  </Dialog>
  <Dialog id="20" name="MSG_017_0_0" type="Message">
    <Page spk="0002"><![CDATA[{f 0 5 254}{f 2 1}Чому ти такий похмурий? Сталося щось погане?[n]{f 1 1}]]></Page>
    <Page spk="0002"><![CDATA[{f 0 5 254}{f 2 1}Хлопчик твого віку має бути щасливим і безтурботним...[n]{f 1 1}]]></Page>
    <Page spk="0002"><![CDATA[{f 0 5 254}{f 2 1}Тобі треба добре поїсти і відпочити, і тобі стане краще![n]{f 1 1}]]></Page>
    <Page spk="0002"><![CDATA[{f 0 5 254}{f 2 1}Ось, візьми суші Інарі...[n]{f 1 1}]]></Page>
  </Dialog>
  <Dialog id="21" name="MND_018_0_0" type="Message">
    <Page spk="FFFF"><![CDATA[{f 0 5 254}{f 2 1}Я отримав {f 4 4 1 37 1 0}.[n]{f 1 1}]]></Page>
  </Dialog>
  <Dialog id="22" name="MSG_019_0_0" type="Message">
    <Page spk="0002"><![CDATA[{f 0 5 254}{f 2 1}Не занепадай духом! Ваше покоління — майбутнє Японії![n]{f 1 1}]]></Page>
    <Page spk="0002"><![CDATA[{f 0 5 254}{f 2 1}Вище носа![n]{f 1 1}]]></Page>
  </Dialog>
  <Dialog id="23" name="MND_020_0_0" type="Message">
    <Page spk="FFFF"><![CDATA[{f 0 5 254}{f 2 1}У храмі є суші Інарі, але я не можу[n]просто вкрасти чиюсь їжу.[n]{f 1 1}]]></Page>
    <Page spk="FFFF"><![CDATA[{f 0 5 254}{f 2 1}Треба розвивати характеристику «{f 4 30 0 1 1 0}». Якби вона досягла рівня «{f 4 31 0 5 1 0}», я, можливо, знайшов би інше рішення...[n]{f 1 1}]]></Page>
  </Dialog>
  <Dialog id="24" name="MND_021_0_0" type="Message">
    <Page spk="FFFF"><![CDATA[{f 0 5 254}{f 2 1}Якщо подумати, Елізабет сказала,[n]що хоче спробувати суші...[n]{f 1 1}]]></Page>
  </Dialog>
  <Dialog id="25" name="MND_022_0_0" type="Message">
    <Page spk="FFFF"><![CDATA[{f 0 5 254}{f 2 1}......[n]{f 1 1}]]></Page>
    <Page spk="FFFF"><![CDATA[{f 0 5 254}{f 2 1}У храмі Інарі тихо...[n]{f 1 1}]]></Page>
  </Dialog>
  <Dialog id="26" name="MSG_023_0_0" type="Message">
    <Page spk="0000"><![CDATA[{f 0 5 254}{f 2 1}О, ти повернувся. Обирай, яку карту скопіювати.[n]{f 1 1}]]></Page>
  </Dialog>
</BMD>
