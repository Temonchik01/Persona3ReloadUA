    <Speaker id="2" rawBytes="59 75 6B 61 72 69 20 54 61 6B 65 62 61">Юкарі Такеба</Speaker>
    <Speaker id="3" rawBytes="46 75 75 6B 61 20 59 61 6D 61 67 69 73 68 69">Фуука Ямаґіші</Speaker>
    <Speaker id="4" rawBytes="4E 61 74 73 75 6B 69 20 4D 6F 72 69 79 61 6D 61">Нацукі Моріяма</Speaker>
    <Speaker id="5" rawBytes="49 6B 75 74 73 75 6B 69 27 73 20 56 6F 69 63 65">Голос Ікуцукі</Speaker>
    <Speaker id="6" rawBytes="53 68 75 6A 69 20 49 6B 75 74 73 75 6B 69">Шюджі Ікуцукі</Speaker>
    <Speaker id="7" rawBytes="4B 65 6E 20 41 6D 61 64 61">Кен Амада</Speaker>
    <Speaker id="8" rawBytes="45 6C 65 6D 65 6E 74 61 72 79 20 53 63 68 6F 6F 6C 20 53 74 75 64 65 6E 74">Учень початкової школи</Speaker>
