  </Dialog>
  <Dialog id="1" name="MSG_001_0_0" type="Message">
    <Page spk="0001"><![CDATA[{f 0 5 254}{f 2 1}{f 3 1 1 0 6 4 12 0}Маєш хвилинку поговорити? Я все думаю про те, що сталося...[n]{f 1 1}]]></Page>
  </Dialog>
  <Dialog id="2" name="SEL_002_0_0" type="Selection">
